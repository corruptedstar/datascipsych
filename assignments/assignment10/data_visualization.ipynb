   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "ce429199",
   "metadata": {
    "editable": true,
    "slideshow": {
     "slide_type": ""
    },
    "tags": []
   },
   "outputs": [
    {
     "data": {
<<<<<<< HEAD
      "image/png": "",
