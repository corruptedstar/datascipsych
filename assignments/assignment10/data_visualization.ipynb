    "cat_lt = (\n",
    "    fr.group_by(\"subject\", \"category\", \"list_type\")\n",
    "    .agg(pl.col(\"recall\").mean())\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cb234f3a",
   "metadata": {
    "editable": true,
    "slideshow": {
     "slide_type": "slide"
